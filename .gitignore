# ============================================
# 以下为复现组补充（作者原文件之外）
# 原因：作者仓库为多项目共用，以下规则是其遗漏项
# ============================================

# ---- 编译输出目录（作者未覆盖）----
build/
obj/

# ---- LLVM 插桩中间产物（作者只写死了两个具体 .bc 文件）----
*.bc
*.bca
*.ll
*.s
llvm/

# ---- Python 缓存（作者完全未覆盖）----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---- 日志（作者只有 */log.txt）----
*.log
*.log.gz

# ---- 压缩包补充 ----
*.zip

# ---- 磁盘镜像 / 虚拟机（备用，其他论文方向）----
*.img
*.qcow2
*.vmdk
*.iso
*.vdi

# ---- 大数据 / trace（备用）----
data/
*.trace

# ---- 凭证（作者完全未覆盖，最危险的一类）----
.env
credentials*
*.key
*.pem
*.p12

# ---- PERIOD 运行临时产物 ----
out_*/**/tmp/

# ---- 编辑器 / 系统垃圾 ----
.vscode/
.idea/
*.swp
Thumbs.db
